1.Number complement
int findComplement(int num) {
    unsigned int mask = 1;
    
    while (mask < num) {
        mask = (mask << 1) | 1;
    }
    
    return num ^ mask;
}


2.Counting bits
#include <stdlib.h>

int* countBits(int n, int* returnSize) {
    *returnSize = n + 1;
    int* ans = (int*)malloc((*returnSize) * sizeof(int));
    
    ans[0] = 0;
    for (int i = 1; i <= n; i++) {
        ans[i] = ans[i & (i - 1)] + 1;
    }
    
    return ans;
}
