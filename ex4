// Structure to represent an edge in our adjacency list
typedef struct EdgeNode {
    int to;
    int cost; // 1 if edge points away from 0, 0 if it points towards 0
    struct EdgeNode* next;
} EdgeNode;

int minReorder(int n, int** connections, int connectionsSize, int* connectionsColSize) {
    // Array of pointers to track the adjacency list for each node
    EdgeNode** adj = (EdgeNode**)calloc(n, sizeof(EdgeNode*));
    
    // Build the graph
    for (int i = 0; i < connectionsSize; i++) {
        int u = connections[i][0];
        int v = connections[i][1];
        
        // Original directed edge u -> v (moves away from city 0, cost = 1)
        EdgeNode* edge1 = (EdgeNode*)malloc(sizeof(EdgeNode));
        edge1->to = v;
        edge1->cost = 1;
        edge1->next = adj[u];
        adj[u] = edge1;
        
        // Virtual reverse edge v -> u (moves toward city 0, cost = 0)
        EdgeNode* edge2 = (EdgeNode*)malloc(sizeof(EdgeNode));
        edge2->to = u;
        edge2->cost = 0;
        edge2->next = adj[v];
        adj[v] = edge2;
    }
    
    // Allocate data tracking structures for BFS
    bool* visited = (bool*)calloc(n, sizeof(bool));
    int* queue = (int*)malloc(n * sizeof(int));
    int head = 0, tail = 0;
    
    // Start the BFS traversal from the capital city (0)
    queue[tail++] = 0;
    visited[0] = true;
    
    int total_changes = 0;
    
    while (head < tail) {
        int curr = queue[head++];
        
        // Travel through all connections bound to the current city
        EdgeNode* edge = adj[curr];
        while (edge != NULL) {
            if (!visited[edge->to]) {
                visited[edge->to] = true;
                total_changes += edge->cost;
                queue[tail++] = edge->to;
            }
            edge = edge->next;
        }
    }
    
    // Explicit manual memory cleanup blocks to prevent memory leaks
    for (int i = 0; i < n; i++) {
        EdgeNode* curr = adj[i];
        while (curr != NULL) {
            EdgeNode* temp = curr;
            curr = curr->next;
            free(temp);
        }
    }
    free(adj);
    free(visited);
    free(queue);
    
    return total_changes;
}
#include <stdio.h>
#include <stdlib.h>
