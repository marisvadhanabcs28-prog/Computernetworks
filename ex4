// Structure to represent an edge in the adjacency list (stop -> buses)
typedef struct Node {
    int bus_id;
    struct Node* next;
} Node;

// Structure for BFS queue items
typedef struct {
    int stop;
    int bus_count;
} QueueItem;

int numBusesToDestination(int** routes, int routesSize, int* routesColSize, int source, int target) {
    // Edge case: Already at the target destination
    if (source == target) return 0;

    // Find the maximum stop ID to size our adjacency list dynamically
    int max_stop = 0;
    for (int i = 0; i < routesSize; i++) {
        for (int j = 0; j < routesColSize[i]; j++) {
            if (routes[i][j] > max_stop) {
                max_stop = routes[i][j];
            }
        }
    }
    if (source > max_stop || target > max_stop) return -1;

    // Allocate memory for the graph mapping: Stop ID -> Linked List of Bus IDs
    Node** stop_to_buses = (Node**)calloc(max_stop + 1, sizeof(Node*));
    
    // Total number of stops across all routes combined to bound our queue size
    int total_stops = 0;
    for (int i = 0; i < routesSize; i++) {
        total_stops += routesColSize[i];
        for (int j = 0; j < routesColSize[i]; j++) {
            int stop = routes[i][j];
            Node* newNode = (Node*)malloc(sizeof(Node));
            newNode->bus_id = i;
            newNode->next = stop_to_buses[stop];
            stop_to_buses[stop] = newNode;
        }
    }

    // Allocate lookup tracking arrays for visited entities
    bool* visited_stops = (bool*)calloc(max_stop + 1, sizeof(bool));
    bool* visited_buses = (bool*)calloc(routesSize, sizeof(bool));

    // Initialize BFS Queue
    QueueItem* queue = (QueueItem*)malloc((total_stops + 1) * sizeof(QueueItem));
    int head = 0, tail = 0;

    // Push initial source element
    queue[tail++] = (QueueItem){source, 0};
    visited_stops[source] = true;

    int result = -1;

    // Begin BFS Loop
    while (head < tail) {
        QueueItem current = queue[head++];
        int curr_stop = current.stop;
        int curr_count = current.bus_count;

        // Iterate through all buses passing through the current stop
        Node* curr_bus_node = stop_to_buses[curr_stop];
        while (curr_bus_node != NULL) {
            int bus_id = curr_bus_node->bus_id;

            if (!visited_buses[bus_id]) {
                visited_buses[bus_id] = true;

                // Check all stops reachable via this specific bus route
                for (int i = 0; i < routesColSize[bus_id]; i++) {
                    int next_stop = routes[bus_id][i];

                    if (next_stop == target) {
                        result = curr_count + 1;
                        goto cleanup; // Break completely out of nested loop structures
                    }

                    if (!visited_stops[next_stop]) {
                        visited_stops[next_stop] = true;
                        queue[tail++] = (QueueItem){next_stop, curr_count + 1};
                    }
                }
            }
            curr_bus_node = curr_bus_node->next;
        }
    }

cleanup:
    // Memory Cleanup
    for (int i = 0; i <= max_stop; i++) {
        Node* curr = stop_to_buses[i];
        while (curr != NULL) {
            Node* temp = curr;
            curr = curr->next;
            free(temp);
        }
    }
    free(stop_to_buses);
    free(visited_stops);
    free(visited_buses);
    free(queue);

    return result;
}
