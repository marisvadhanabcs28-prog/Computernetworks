#define INF 1e8 // Set an upper limit safely above any possible flight cost combination

int findCheapestPrice(int n, int** flights, int flightsSize, int* flightsColSize, int src, int dst, int k) {
    // Allocate the core prices array
    int* prices = (int*)malloc(n * sizeof(int));
    int* temp_prices = (int*)malloc(n * sizeof(int));
    
    // Initialize prices to infinity
    for (int i = 0; i < n; i++) {
        prices[i] = INF;
    }
    prices[src] = 0;
    
    // Relax the edges exactly k + 1 times (representing up to k stops)
    for (int i = 0; i <= k; i++) {
        // Copy current prices into temporary storage
        for (int j = 0; j < n; j++) {
            temp_prices[j] = prices[j];
        }
        
        // Loop through all available flights
        for (int j = 0; j < flightsSize; j++) {
            int u = flights[j][0];
            int v = flights[j][1];
            int price = flights[j][2];
            
          
            if (prices[u] == INF) {
                continue;
            }
            
            // Check if traveling to city 'v' via city 'u' yields a cheaper price
            if (prices[u] + price < temp_prices[v]) {
                temp_prices[v] = prices[u] + price;
            }
        }
        
        // Swap or assign temp_prices back to the primary prices array
        int* swap = prices;
        prices = temp_prices;
        temp_prices = swap;
    }
    
    int result = (prices[dst] == INF) ? -1 : prices[dst];
    
    // Free dynamically allocated memory blocks
    free(prices);
    free(temp_prices);
    
    return result;
}
