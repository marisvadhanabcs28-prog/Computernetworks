#define INF 1e9

// Structure to represent an edge in the adjacency list
typedef struct EdgeNode {
    int to;
    int weight;
    struct EdgeNode* next;
} EdgeNode;

// Heap element structure
typedef struct {
    int node;
    int time;
} HeapNode;

// Structure to represent our Min-Heap
typedef struct {
    HeapNode* data;
    int size;
    int capacity;
} MinHeap;

// Min-Heap Utility Functions
MinHeap* createMinHeap(int capacity) {
    MinHeap* heap = (MinHeap*)malloc(sizeof(MinHeap));
    heap->data = (HeapNode*)malloc(capacity * sizeof(HeapNode));
    heap->size = 0;
    heap->capacity = capacity;
    return heap;
}

void swap(HeapNode* a, HeapNode* b) {
    HeapNode temp = *a;
    *a = *b;
    *b = temp;
}

void push(MinHeap* heap, int node, int time) {
    heap->data[heap->size] = (HeapNode){node, time};
    int i = heap->size;
    heap->size++;
    
    // Bubble up
    while (i > 0 && heap->data[i].time < heap->data[(i - 1) / 2].time) {
        swap(&heap->data[i], &heap->data[(i - 1) / 2]);
        i = (i - 1) / 2;
    }
}

HeapNode pop(MinHeap* heap) {
    HeapNode top = heap->data[0];
    heap->size--;
    heap->data[0] = heap->data[heap->size];
    
    int i = 0;
    // Bubble down
    while (2 * i + 1 < heap->size) {
        int left = 2 * i + 1;
        int right = 2 * i + 2;
        int smallest = left;
        
        if (right < heap->size && heap->data[right].time < heap->data[left].time) {
            smallest = right;
        }
        if (heap->data[i].time <= heap->data[smallest].time) {
            break;
        }
        swap(&heap->data[i], &heap->data[smallest]);
        i = smallest;
    }
    return top;
}

int networkDelayTime(int** times, int timesSize, int* timesColSize, int n, int k) {
    // Allocate adjacency list graph representation (1-indexed nodes)
    EdgeNode** graph = (EdgeNode**)calloc(n + 1, sizeof(EdgeNode*));
    for (int i = 0; i < timesSize; i++) {
        int u = times[i][0];
        int v = times[i][1];
        int w = times[i][2];
        
        EdgeNode* edge = (EdgeNode*)malloc(sizeof(EdgeNode));
        edge->to = v;
        edge->weight = w;
        edge->next = graph[u];
        graph[u] = edge;
    }
    
    // Distances array initialization
    int* dist = (int*)malloc((n + 1) * sizeof(int));
    for (int i = 1; i <= n; i++) dist[i] = INF;
    
    // Create priority queue max potential capacity bounded by possible edge items
    MinHeap* heap = createMinHeap(timesSize * 2 + 1);
    
    // Start Dijkstra calculation
    dist[k] = 0;
    push(heap, k, 0);
    
    while (heap->size > 0) {
        HeapNode curr = pop(heap);
        int u = curr.node;
        int d = curr.time;
        
        if (d > dist[u]) continue;
        
        EdgeNode* edge = graph[u];
        while (edge != NULL) {
            int v = edge->to;
            int weight = edge->weight;
            
            if (dist[u] + weight < dist[v]) {
                dist[v] = dist[u] + weight;
                push(heap, v, dist[v]);
            }
            edge = edge->next;
        }
    }
    
    // Collect the max travel time safely across all active components
    int max_time = 0;
    for (int i = 1; i <= n; i++) {
        if (dist[i] == INF) {
            max_time = -1; // Node unreached
            break;
        }
        if (dist[i] > max_time) {
            max_time = dist[i];
        }
    }
    
    // Memory cleanup
    for (int i = 1; i <= n; i++) {
        EdgeNode* curr = graph[i];
        while (curr != NULL) {
            EdgeNode* temp = curr;
            curr = curr->next;
            free(temp);
        }
    }
    free(graph);
    free(dist);
    free(heap->data);
    free(heap);
    
    return max_time;
}

